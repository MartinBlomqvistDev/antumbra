{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "antumbra",
  "compatibility_date": "2026-08-07",
  // Assets-only Worker: no script runs, Cloudflare serves the static export
  // from out/ straight off the edge. Deployment happens earliest at the
  // protocol's day 40; this file exists so that launch day is a single
  // `npm run deploy`, not configuration work.
  "assets": {
    "directory": "./out"
  },
  "workers_dev": true,
  "preview_urls": true
  // The custom domain is antumbraprojektet.se, registered 23 October 2026. A
  // custom domain for a Worker requires the zone to sit in Cloudflare, so
  // these two routes are enabled once the nameservers have moved there, and
  // not before: a deploy with routes on a zone Cloudflare does not hold
  // fails. Until then the Worker answers on its workers.dev name.
  // "routes": [
  //   { "pattern": "antumbraprojektet.se", "custom_domain": true },
  //   { "pattern": "www.antumbraprojektet.se", "custom_domain": true }
  // ]
}
