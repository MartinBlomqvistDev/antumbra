{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "antumbra",
  "compatibility_date": "2026-08-07",
  // Assets-only Worker: no script runs, Cloudflare serves the static export
  // from out/ straight off the edge. Deployment happens earliest at the
  // protocol's day 40; this file exists so that launch day is a single
  // `npm run deploy`, not configuration work.
  "assets": {
    "directory": "./out"
  },
  "workers_dev": true,
  "preview_urls": true,
  // The custom domain is antumbraprojektet.se, registered 23 October 2026 and
  // moved to Cloudflare's nameservers the same day. A custom domain for a
  // Worker requires the zone to sit in Cloudflare, and the deploy creates the
  // DNS record for each pattern itself. One.com's own A records for the apex
  // and www were deleted from the zone first: they pointed at their web
  // hosting, which this project does not use, and a record already on the
  // name makes the custom domain fail to attach.
  "routes": [
    { "pattern": "antumbraprojektet.se", "custom_domain": true },
    { "pattern": "www.antumbraprojektet.se", "custom_domain": true }
  ]
}
